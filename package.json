{
  "name": "people-marketing-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.{ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json,md}\"",
    "emulators": "firebase emulators:start --only auth,firestore",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "rules:test": "firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "seed": "firebase emulators:exec --project peoplemarketing-c5bfd --only auth,firestore \"tsx scripts/seed.ts\"",
    "grant-role": "firebase emulators:exec --project peoplemarketing-c5bfd --only auth,firestore \"tsx scripts/grantRole.ts\"",
    "delete-user": "firebase emulators:exec --project peoplemarketing-c5bfd --only auth,firestore \"tsx scripts/deleteUser.ts\""
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "date-fns": "~3.6.0",
    "firebase": "~10.12.0",
    "mapbox-gl": "^3.29.0",
    "pinia": "~2.1.7",
    "vue": "~3.4.21",
    "vue-router": "~4.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "~3.0.4",
    "@playwright/test": "~1.44.0",
    "@tailwindcss/forms": "~0.5.7",
    "@tailwindcss/typography": "~0.5.13",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/mapbox-gl": "^3.4.1",
    "@typescript-eslint/eslint-plugin": "~7.7.0",
    "@typescript-eslint/parser": "~7.7.0",
    "@vitejs/plugin-vue": "~5.0.4",
    "@vitest/coverage-v8": "~1.6.0",
    "@vue/test-utils": "~2.4.6",
    "@vue/tsconfig": "~0.5.1",
    "autoprefixer": "~10.4.19",
    "eslint": "~8.57.0",
    "eslint-plugin-tailwindcss": "~3.14.0",
    "eslint-plugin-vue": "~9.25.0",
    "firebase-admin": "~12.3.0",
    "firebase-tools": "~13.7.2",
    "jsdom": "~24.0.0",
    "postcss": "~8.4.38",
    "prettier": "~3.2.5",
    "prettier-plugin-tailwindcss": "~0.5.14",
    "tailwindcss": "~3.4.3",
    "tsx": "~4.7.0",
    "typescript": "~5.4.5",
    "vite": "~5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~1.6.0",
    "vue-tsc": "~2.0.13"
  }
}
