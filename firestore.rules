rules_version = '2';

// Ticket 01 — full RBAC. Three roles: Administrator / TeamManager / TeamMember.
//
// Role source: Firestore, NOT custom claims. Originally this used
// request.auth.token.{role,officeId,isTeamLeader} set via a Cloud Function,
// but that requires the Blaze billing plan — Stan opted to stay on the free
// Spark plan instead. So role/office/isTeamLeader live ONLY on
// /users/{uid} and every rule below reads that doc with get(). See
// decisions/006-firestore-roles-no-claims.md for the full reasoning
// (supersedes the claims-based approach in decisions/001 and 005).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // One read of the caller's own /users/{uid} doc. get() does not
    // re-run security rules — it's a direct data fetch — so this can't
    // recurse into the /users/{userId} match block below.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? myProfile().role : null;
    }

    function myOfficeId() {
      return isSignedIn() ? myProfile().primaryOfficeId : null;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'Administrator';
    }

    function isManager() {
      return isSignedIn() && myRole() == 'TeamManager';
    }

    function isMember() {
      return isSignedIn() && myRole() == 'TeamMember';
    }

    function sameOffice(officeId) {
      return isSignedIn() && myOfficeId() == officeId;
    }

    // Multi-office: an Administrator is staff of EVERY office, not just
    // their own primaryOfficeId — the client-side office switcher
    // (useActiveOffice/AppShell) lets them do the same CRUD in any office
    // they pick. A TeamManager stays office-locked, same as before.
    function isStaffOf(officeId) {
      return isAdmin() || (sameOffice(officeId) && isManager());
    }

    match /users/{userId} {
      // Own doc always readable; admin can read any user (needed to see
      // pending signups before they have an office at all).
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Self-signup: a user may create their OWN pending profile doc, but only
      // with role/primaryOfficeId left null — granting either is a privilege
      // escalation. `desiredOfficeId` is just a hint for the approving admin
      // (which office they applied to) — it carries no authorization weight.
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
          && request.resource.data.role == null
          && request.resource.data.primaryOfficeId == null
          && request.resource.data.desiredOfficeId is string
          && request.resource.data.desiredOfficeId.size() > 0);
      // Role assignment: admin can grant role/office/isTeamLeader directly —
      // no Cloud Function needed now that role lives in Firestore. Multi-office:
      // an Administrator may assign into ANY office (not just their own) — the
      // office switcher is how they pick which one, same as isStaffOf below.
      //
      // Self-service (Settings page): a non-admin may update ONLY their own
      // doc's phone/phoneVerified/emailVerified — every other field (role,
      // office, isActive, email, displayName…) must come out unchanged, so
      // this can never be used as a privilege-escalation path. `phoneVerified`
      // is a self-attestation ("I confirm this number is correct"), done by
      // the user themselves as a todo on Settings — not an admin sign-off,
      // since there's no Firebase Phone Auth here to check it automatically
      // (SMS needs Blaze) either way, so an admin confirming it wasn't any
      // more trustworthy than the user doing it themselves. `emailVerified`
      // must match the caller's own ID token claim — it can't be
      // self-attested to an arbitrary value the same way.
      function selfProfileUpdateOnly() {
        return isSignedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.primaryOfficeId == resource.data.primaryOfficeId
          && request.resource.data.desiredOfficeId == resource.data.desiredOfficeId
          && request.resource.data.isTeamLeader == resource.data.isTeamLeader
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.email == resource.data.email
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && request.resource.data.phoneVerified is bool;
      }
      allow update: if (isAdmin() && request.resource.data.role in ['Administrator', 'TeamManager', 'TeamMember'])
        || selfProfileUpdateOnly();
      allow delete: if isAdmin();
    }

    match /offices/{officeId} {
      // Public read: the office directory (name/timezone/isActive — nothing
      // sensitive) has to be browsable from SignupView by a visitor who
      // doesn't have an account yet, so they can say which office they're
      // applying to (see decisions/005). Sub-collections below stay fully
      // locked down regardless of this.
      allow read: if true;
      // Multi-office: any Administrator may create/edit an office (e.g. a
      // second office going live); write is not office-scoped for admins.
      allow write: if isAdmin();

      match /employees/{employeeId} {
        // Admin + manager see the full roster; a member only sees their own doc.
        allow read: if isStaffOf(officeId) || (isMember() && sameOffice(officeId) && request.auth.uid == employeeId);
        // The employee doc ID MUST be the Auth uid of a real account already
        // assigned to THIS office (decisions/007). The read rule above compares
        // request.auth.uid to employeeId, and the shifts rules compare it to
        // assignedEmployeeId — so a doc keyed by an auto-generated ID is
        // permanently invisible to the person it represents. Enforcing it here
        // means no client can ever recreate that bug, not just the one that
        // used to call addDoc(). Multi-office: admin isn't sameOffice-restricted
        // here either, but the target account's OWN primaryOfficeId must still
        // match this office — an admin can't file someone under the wrong one.
        allow create: if isAdmin()
          && exists(/databases/$(database)/documents/users/$(employeeId))
          && get(/databases/$(database)/documents/users/$(employeeId)).data.primaryOfficeId == officeId;
        allow update, delete: if isAdmin();
      }

      match /shifts/{shiftId} {
        // Admin + manager read all shifts in the office; a member reads only their own.
        allow read: if isStaffOf(officeId) || (isMember() && sameOffice(officeId) && resource.data.assignedEmployeeId == request.auth.uid);

        // Create: admin/manager may draft a shift for anyone in the office; a
        // member may draft/submit only their OWN shift — decision 008,
        // employee-authored planning ("employees plan themselves in, admin
        // approves"), not admin-published open slots.
        function ownsShift() {
          return request.resource.data.assignedEmployeeId == request.auth.uid;
        }
        allow create: if (isStaffOf(officeId) && request.resource.data.status in ['draft', 'pending'])
          || (isMember() && sameOffice(officeId) && ownsShift() && request.resource.data.status in ['draft', 'pending']);

        // Update: admin can do anything in their office, including walking a
        // shift backwards (approved -> pending). A manager or member may only
        // touch a shift that IS CURRENTLY draft/pending and may not move it
        // past pending themselves — checking only the incoming status here
        // (ticket-03 defect) let a manager silently un-approve a shift by
        // writing status: 'pending' over an already-approved doc. A member is
        // further restricted to their own shift, and can't reassign it.
        allow update: if isAdmin()
          || (isManager() && sameOffice(officeId)
              && resource.data.status in ['draft', 'pending']
              && request.resource.data.status in ['draft', 'pending'])
          || (isMember() && sameOffice(officeId)
              && resource.data.assignedEmployeeId == request.auth.uid
              && resource.data.status in ['draft', 'pending']
              && ownsShift()
              && request.resource.data.status in ['draft', 'pending']);

        // Delete: admin, any office. A member may also delete their own
        // draft before ever submitting it (undo an accidental add).
        allow delete: if isAdmin()
          || (isMember() && sameOffice(officeId)
              && resource.data.assignedEmployeeId == request.auth.uid
              && resource.data.status == 'draft');
      }

      match /recruitmentLeads/{leadId} {
        // Members get read-only visibility per the client transcript; admin/manager write.
        allow read: if isStaffOf(officeId) || (isMember() && sameOffice(officeId));
        allow write: if isStaffOf(officeId);
      }

      match /auditLog/{entryId} {
        // FRD §19 audit trail — append-only. No update/delete for ANYONE,
        // not even an admin: a log that can be edited after the fact isn't
        // an audit trail. Same visibility/write gate as staff actions
        // generally (isStaffOf already grants any Administrator access
        // office-agnostically, see the multi-office comment above).
        allow read: if isStaffOf(officeId);
        allow create: if isStaffOf(officeId);
        allow update, delete: if false;
      }

      match /locations/{locationId} {
        // Location Manager (client asked for a briggsandwalker-style
        // canvassing map+list, meetings/2026-08-25-client-callback-new-asks
        // item 7). Members need read access to see where to go; only staff
        // (admin/manager) manage the location list itself.
        allow read: if isStaffOf(officeId) || (isMember() && sameOffice(officeId));
        allow create, delete: if isStaffOf(officeId);
        // Update: staff may edit anything. A member never touches the
        // location's own fields (name/address/status/etc) — the ONLY write
        // they're allowed here is the visit-counter bump that
        // locationsService.logVisit batches alongside a visits/{visitId}
        // create, so their write must be exactly "timesVisited +1,
        // lastVisitedAt set" with everything else unchanged.
        function onlyVisitCounterChanged() {
          return request.resource.data.name == resource.data.name
            && request.resource.data.address == resource.data.address
            && request.resource.data.neighbourhood == resource.data.neighbourhood
            && request.resource.data.lat == resource.data.lat
            && request.resource.data.lng == resource.data.lng
            && request.resource.data.status == resource.data.status
            && request.resource.data.timesVisited == resource.data.timesVisited + 1;
        }
        allow update: if isStaffOf(officeId)
          || (isMember() && sameOffice(officeId) && onlyVisitCounterChanged());

        match /visits/{visitId} {
          // Visit log: any signed-in office member can log that THEY visited
          // a location (self-attested, matches the employee-authored shift
          // model in decisions/008) — a team leader/admin needs to see who
          // covered a neighbourhood, not just staff-logged visits.
          allow read: if isStaffOf(officeId) || (isMember() && sameOffice(officeId));
          allow create: if (isStaffOf(officeId) || (isMember() && sameOffice(officeId)))
            && request.resource.data.employeeId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /periods/{periodId} {
        // Historical snapshots are written server-side only (Cloud Function via Admin SDK,
        // which bypasses these rules entirely) — no client writes, ever.
        allow read: if isAdmin() || sameOffice(officeId);
        allow write: if false;
      }
    }
  }
}
