rules_version = '2';

// Minimal rules for the Phase 1 scaffold (Ticket 0). Tightened in Ticket 1
// once Employee/Shift/Recruitment collections land and RBAC plumbing is wired.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}